TELEGRAM_BOT_TOKEN=123456:replace-me

# Comma-separated Telegram user ids.
ADMIN_USER_IDS=123456789
PERMANENT_ALLOWED_USER_IDS=123456789,987654321

# Runtime paths inside Docker/LXC.
DATA_DIR=/app/data
TEMP_DIR=/tmp/m3u8-saver

# Download limits.
MAX_VIDEO_BYTES=2147483648
FFMPEG_TIMEOUT_SECONDS=7200
HTTP_TIMEOUT_SECONDS=20

# Keep false for stream-copy remuxing. Set true only if you need re-encoding.
TRANSCODE_VIDEO=false
PREFERRED_ACCEL=auto

# Optional extra headers for source websites.
DEFAULT_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125 Safari/537.36
DEFAULT_ACCEPT_LANGUAGE=ru-RU,ru;q=0.9,en-US;q=0.8,en;q=0.7

# Optional. Only use cookies from your own browser/session for sources you are allowed to access.
# SOURCE_COOKIE=sessionid=abc; other_cookie=xyz
SOURCE_COOKIE=

# Optional. Use only your own YouTube cookies for videos you are allowed to download.
YOUTUBE_COOKIE=

# Logging. LOG_FILE is optional; Docker logs still receive console output.
LOG_LEVEL=INFO
LOG_FILE=/app/data/bot.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
